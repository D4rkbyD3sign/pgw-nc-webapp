// Firestore security rules — PGW National Conference brain.
//
// These are the ONLY thing standing between the open internet and the database.
// The apiKey in config.js is public by design; this file is what makes that safe.
//
// Paste into: Firebase console -> Firestore Database -> Rules -> Publish.
// Kept in the repo so the live rules have a reviewable source of truth.
//
// 2026-07-27, v2 — HARDENED after a real hole was found.
// v1 said "allow list: if request.auth != null" — anyone signed in. But the
// public apiKey plus Firebase's default "Enable create (sign-up)" meant a
// stranger could REGISTER THEMSELVES and then read the whole queue, including
// dismissed questions. Two fixes: sign-up is now disabled in the console, AND
// crew access is pinned to named people below. Belt and braces — either alone
// would do, and neither alone is enough to rely on.
// Found because GitHub's secret scanner emailed Adam about the apiKey and he
// forwarded it instead of ignoring it.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The crew. Add a moderator by adding their address here AND creating the
    // user in Firebase console -> Authentication -> Users. Both are required:
    // an account that isn't listed here can sign in but sees nothing.
    function isCrew() {
      return request.auth != null
             && request.auth.token.email in [
                  'a.graham@thesolomons.com.au'
                ];
    }

    match /events/{eventId}/questions/{questionId} {

      // ANYONE MAY ASK — no sign-in, no identity, that's the whole point.
      // But only a well-formed, pending question, stamped by the SERVER clock:
      // a phone with a wrong clock must not be able to jump the moderator queue,
      // and nobody gets to post themselves straight onto the big screen.
      allow create: if request.resource.data.keys().hasOnly(['sessionId', 'text', 'status', 'ts'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.ts == request.time
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 400
                    && request.resource.data.sessionId is string
                    && request.resource.data.sessionId.size() <= 64;

      // A phone may read back a question whose id it already knows — its own,
      // because that id is kept only on that device. It may NOT list the
      // collection: pending and dismissed questions are the moderator's
      // business. Someone's rejected question is not public.
      allow get: if true;
      allow list: if isCrew();

      // Only named crew curate, and may only move the status —
      // never rewrite what an attendee actually asked.
      allow update: if isCrew()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if isCrew();
    }

    // Pulse surveys — one 1-5 rating + optional comment, per session.
    // Stricter than questions on reads: an attendee never needs to read a
    // response back (there is no status to track), so NOBODY outside the crew
    // reads them at all. Not even by id.
    match /events/{eventId}/responses/{responseId} {

      allow create: if request.resource.data.keys().hasOnly(['sessionId', 'rating', 'comment', 'ts'])
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.ts == request.time
                    && request.resource.data.sessionId is string
                    && request.resource.data.sessionId.size() <= 64
                    && (!('comment' in request.resource.data)
                        || (request.resource.data.comment is string
                            && request.resource.data.comment.size() <= 400));

      allow read: if isCrew();
      allow update, delete: if isCrew();
    }

    // Everything else stays shut until it is deliberately opened.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
